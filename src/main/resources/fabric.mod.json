{
  "schemaVersion": 1,
  "id": "betterfonts",
  "version": "${version}",
  "name": "Better Fonts",
  "description": "Use Google Fonts in Minecraft with smooth, high-quality text rendering.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": { "client": ["dev.betterfonts.BetterFontsMod"] },
  "mixins": ["betterfonts.mixins.json"],
  "depends": {
    "minecraft": "${minecraft_dep}",
    "fabricloader": ">=${loader_min}",
    "fabric-api": "*",
    "java": ">=${java_min}"
  }
}
